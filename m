-# kind, whether express or implied; without even the implied warranty
-# of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
-# GNU General Public License for more details.
-###############################################################################
-
-# @desc Take an application as a parameter and execute the application.  Check
-#       the 'ps' output to verify that the application was able to start
-#       running.  Then kill the application.  This is useful for testing the
-#       launching of application that require user intervention to work.
-#       This script will also check if the application is in the default PATH
-#       unless the -n option is used
-# @params a) application to execute
-#         n) skip the path check
-#         k) application name to use to kill the launched app (in case it
-#            can't be derived from the called application)
-# @returns This script returns a non-zero value on failure
-# @history 2011-05-24: First version (Chase Maupin)
-
-source "common.sh"  # Import do_cmd(), die() and other functions
-
-############################# Functions #######################################
-usage()
-{
-    echo "Usage:"
-    echo "  $0 -a <application> [-nh -k <killname>]"
-    echo ""
-    echo "Parameters:"
-    echo "  -a: Application to execute"
-    echo "  -n: Skip PATH check"
-    echo "  -k: Name to use to kill application"
-    echo "  -h: This message"
-    echo ""
-    echo "NOTE: When specifying the application parameter it is possible to"
-    echo "      pass complex strings such as:"
-    echo "          \"/usr/bin/dhrystone_static 30000000 1000000\""
-    echo "      In cases such as this the command to check for is the first"
-    echo "      part of the application string but the application executed"
-    echo "      is the entire string with parameters"
-	exit 1
-}
-
-############################ Script Variables ##################################
-# List the variables used in the script and set their defaults here
-no_path_check="false"
-killname=""
-
-################################ CLI Params ####################################
-# Please use getopts
-while getopts  :a:nk:h arg
-do case $arg in
-        a)      app="$OPTARG";;
-        n)      no_path_check="true";;
-        k)      killname="$OPTARG";;
-        h)      usage;;
-        :)      die "$0: Must supply an argument to -$OPTARG.";; 
-        \?)     die "Invalid Option -$OPTARG ";;
-esac
-done
-
-########################### REUSABLE TEST LOGIC ###############################
-check_in_path() {
-  if [ "$no_path_check" == "false" ]
-  then
-    # Only evaluate the first part of the application string in case
-    # parameters are passed to the application.
-    which $1
-    if [ $? -ne 0 ]
-    then
-      test_print_trc "Command ($app) was not found in the PATH"
-      exit 1
-    fi
-  fi
-}
-
-# Use do_cmd() (imported from common.sh) to execute your test steps.
-# do_cmd() will check return code and fail the test is return code is non-zero.
-
-check_mandatory_inputs app
-
-check_in_path $app
-
-# Get the basename off the application to be used when checking ps and killing
-# the application (unless killname is passed)
-if [ "$killname" == "" ]
-then
-  # use for as a cheap splitter operation to divide by whitespace
-  for x in $app
-  do
-    killname=`basename $x`
-    break
-  done
-fi

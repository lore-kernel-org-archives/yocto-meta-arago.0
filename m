-+static int af_alg_ciphers(ENGINE *e, const EVP_CIPHER **cipher, const int **nids, int nid)
-+{
-+	if( !cipher )
-+	{
-+		*nids = af_alg_cipher_nids;
-+		return af_alg_cipher_nids_num;
-+	}
-+
-+	if( ! nid_in_nids(nid, af_alg_cipher_nids, af_alg_cipher_nids_num) )
-+		return 0;
-+

>> ++    char buf[MAX_ROW_SIZE], *pos = buf, *max = &buf[MAX_ROW_SIZE-1];
>> ++    char *tmp;
>> ++    int i;
>> ++
>> ++    if (lreInterfaceConfigTable_container_should_save(rowreq_ctx) == 0) {
>> ++        return SNMP_ERR_NOERROR;

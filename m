-#!/bin/bash
-
-# Translate OE machine types to opentest HW platforms and don't test on
-# unsupported platforms.
-# NOTE: Some platforms re-use the same board so we can set oplatform the same
-set_opentest_platform() {
-    machine="$1"
-
-    case $machine in
-        am37x-evm|am180x-evm|omapl138-lcdk|am3517-evm|da850-omapl138-evm|beagleboard|beaglebone|am335x-evm|omap5-evm|dra7xx-evm|am57xx-evm )
-            oplatform=$machine
-            ;;
-        k2hk-evm|k2e-evm|k2g-evm|k2l-evm|k2g-ice )
-            oplatform=$machine
-            ;;
-        am437x-evm )
-            oplatform="am43xx-gpevm"
-            ;;
-        am335x-hs-evm )
-            oplatform="am335x-hsevm"
-            ;;
-        am437x-hs-evm )
-            oplatform="am43xx-hsevm"
-            ;;
-        am57xx-hs-evm )
-            oplatform="am57xx-hsevm"
-            ;;
-        dra7xx-hs-evm )
-            oplatform="dra7xx-hsevm"
-            ;;
-        k2e-hs-evm )
-            oplatform="k2e-hsevm"
-            ;;
-        k2hk-hs-evm )
-            oplatform="k2hk-hsevm"
-            ;;
-        k2g-hs-evm )
-            oplatform="k2g-hsevm"
-            ;;
-        k2l-hs-evm )
-            oplatform="k2l-hsevm"
-            ;;
-        * )
-            return 2
-            ;;
-    esac
-}
-
-# Translate OE machine types to corresponding DTBs that have OpenTest HW
-# available for testing. In some cases, DTBs are named slightly different
-# than machines in OE or OpenTest, or have multiple variants. Select the
-# correct one here.
-set_opentest_dtb() {
-    machine="$1"
-
-    case $machine in
-        am335x-evm|am57xx-evm )
-            odtb="$machine.dtb"
-            ;;
-        am335x-hs-evm )
-            odtb="am335x-evm.dtb"
-            ;;
-        am57xx-hs-evm )
-            odtb="am57xx-evm.dtb"
-            ;;
-        beaglebone )
-            odtb="am335x-boneblack.dtb"
-            ;;
-        am437x-evm )
-            odtb="am437x-gp-evm.dtb"
-            ;;
-        am437x-hs-evm )
-            odtb="am437x-gp-evm.dtb"
-            ;;
-        dra7xx-evm )
-            odtb="dra7-evm.dtb"
-            ;;
-        dra7xx-hs-evm )
-            odtb="dra7-evm.dtb"
-            ;;
-        omap5-evm )
-            odtb="omap5-uevm.dtb"
-            ;;
-        k2hk-evm|k2e-evm|k2g-evm|k2l-evm|k2g-ice )
-            odtb="keystone-$machine.dtb"
-            ;;
-        k2e-hs-evm )
-            odtb="keystone-k2e.dtb"
-            ;;
-        k2hk-hs-evm )
-            odtb="keystone-k2hk.dtb"
-            ;;
-        k2g-hs-evm )
-            odtb="keystone-k2g.dtb"
-            ;;
-        k2l-hs-evm )
-            odtb="keystone-k2l.dtb"
-            ;;
-        * )
-            odtb=""
-            ;;
-    esac
-}
-
-# Call to the opentest framework wo perform build testing.  This requires
-# that the build system is setup with STAF to perform the testing calls.
-# For details see:
-#   TODO: Link to setup page here
-#           - Need to cover opentest_client_jenkins.tar file creation
-#           - Need to cover configuration of STAF
-#           - Need to cover setup of daemonize
-#           - Setup of NFS_ROOT
-#           - Creating a builders group to give sudo rights to
-#           - setup of no password sudo for commands below due to fakeroot
-#             not working for NFS
-run_target_side_test() {
-    # Set m for logging purposes
-    m="$1"
-
-    log $machine_test_log echo "testing machine $m"
-
-################################################################################
-# Prepare the root file system for testing by:
-#   - Creating a subdirectory in the NFS_ROOT directory to extract the target
-#     file system into.  
-#   - Extract the target file system using fakeroot.
-#   - Copy the test scripts into the target file system
-################################################################################
-    nfs_dir="$NFS_ROOT/$m-test"
-
-    mkdir -p $nfs_dir
-
-    if [ "$?" != "0" ]
-    then
-        echo "Could not create $NFS_ROOT directory"
-        echo "FAILED" > $LOG_DIR/$m-test-result.txt
-        return 1
-    fi
-
-    # Find the target file system
-    if [ -d temp/filesystem ]
-    then
-        filesys_path="temp/filesystem"
-    else
-        filesys_path="out"
-    fi
-    filesys=`find ./$filesys_path -name "$FS_FILTER*$FS_IMAGE_TYPE" | xargs basename`
-
-    if [ "$filesys" == "" ]
-    then
-        echo "Could not find the target file system"
-        echo "FAILED: CRITICAL" > $LOG_DIR/$m-test-result.txt
-        return 1
-    fi
-
-    # Copy the file system to the nfs root directory to be extracted
-    cp $filesys_path/$filesys $nfs_dir
-
-    # extract the file system using fakeroot
-    cd $nfs_dir
-
-    sudo tar xf $filesys
-    sudo chmod a+rw `dirname $TEST_SCRIPTS_TGT`
-
-    # Copy in the test scripts from the SCRIPTS_ROOT directory
-    if [ ! -d "$TEST_SCRIPTS" ]
-    then
-        echo "Could not find test scripts at $TEST_SCRIPTS"
-        echo "FAILED" > $LOG_DIR/$m-test-result.txt
-        return 1
-    fi
-
-    sudo cp -rf $TEST_SCRIPTS $TEST_SCRIPTS_TGT
-
-    # Copy init scripts to create fake pointercal/calibrate files to allow booting
-    sudo cp $TEST_SCRIPTS_TGT/S90-fake-pointercal etc/rc5.d/
-    sudo cp $TEST_SCRIPTS_TGT/S08-fake-weston-calibrate etc/rc5.d/
-
-    # Modify the nightly-test.sh script with the required values
-    sudo sed -i "s=__BASEDIR__=/$TEST_SCRIPTS_TGT=" $TEST_SCRIPTS_TGT/nightly-test.sh
-    sudo sed -i "s=__BASEDIR__=/$TEST_SCRIPTS_TGT=" $TEST_SCRIPTS_TGT/opentest.sh
-    sudo sed -i "s=__MACHINE__=$m=" $TEST_SCRIPTS_TGT/nightly-test.sh
-
-    # Make the scripts executable
-    sudo chmod +x $TEST_SCRIPTS_TGT/*.sh
-
-################################################################################
-# Call OpenTest framework
-#   - extract the opentest CLI client
-#   - determine the oplatform to use for testing
-#   - run the opentest CLI client passing the SDK binary images and the
-#     extracted NFS partition
-################################################################################
-    cd $test_dir
-
-    # Check if the client can be found.  In not then mark the test as
-    # SKIPPED
-    if [ ! -e $OPENTEST_CLI ]
-    then
-        echo "Could not find the opentest client tarball"
-        echo "SKIPPED" > $LOG_DIR/$m-test-result.txt
-        return 1
-    fi
-
-    # Extract the CLI utility
-    tar xf $OPENTEST_CLI
-
-    # New version of CLI has "client" subdir
-    mv client/* . || true
-
-    # Copy pre-configured conf/site_info.xml file, if provided
-    if [ ! -z $OPENTEST_CONF_SITE_INFO -a -e $OPENTEST_CONF_SITE_INFO ]
-    then
-        cp -f $OPENTEST_CONF_SITE_INFO config/site_info.xml
-    fi
-
-    # New version of CLI has no version in JAR name
-    if [ -e opentest_cli_0.7.jar ]
-    then
-        OPENTEST_JAR="opentest_cli_0.7.jar"
-    else
-        OPENTEST_JAR="opentest_cli.jar"
-    fi
-
-    # Determine the oplatform to use for testing
-    set_opentest_platform $m
-
-    if [ "$?" == "2" ]
-    then
-        echo "Unknown machine ($m) given to opentest.  Skipping"
-        echo "SKIPPED" > $LOG_DIR/$m-test-result.txt
-        return 1
-    fi
-
-    # Determine the odtb to use for testing
-    set_opentest_dtb $m
-
-    # Set variabled required for the test line.
-    ipaddr=`ifconfig $TEST_LOCAL_IFACE | grep 'inet addr:' | grep -v '127.0.0.1' | cut -d: -f2 | awk '{ print $1 }'`
-
-    if [ "$ipaddr" == "" ]
-    then
-        echo "Could not get host IP address"
-        echo "SKIPPED" > $LOG_DIR/$m-test-result.txt
-        return 1
-    fi
-
-    if [ -f $test_dir/temp/board-support/prebuilt-images/[uz]Image-$m.bin ]
-    then
-        if [ -f $test_dir/temp/board-support/prebuilt-images/zImage-$m.bin ]
-        then
-            kernel=$test_dir/temp/board-support/prebuilt-images/zImage-$m.bin
-        elif [ -f $test_dir/temp/board-support/prebuilt-images/uImage-$m.bin ]
-        then
-            kernel=$test_dir/temp/board-support/prebuilt-images/uImage-$m.bin
-        fi
-
-        if [ "$odtb" ]
-        then
-            dtb="~dtb=$test_dir/temp/board-support/prebuilt-images/$odtb"
-        else
-            dtb=""
-        fi
-    elif [ -f $nfs_dir/boot/vmlinuz-* ]
-    then
-        kernel="$(ls $nfs_dir/boot/vmlinuz-*)"
-        dtb="~dtb=$(ls $nfs_dir/lib/firmware/*/device-tree/$oplatform.dtb)"
-    else
-        echo "Could not find pre-built kernel"
-        echo "SKIPPED" > $LOG_DIR/$m-test-result.txt
-        return 1
-    fi
-
-    uboot=""
-    spluart=""
-    if [ "$OPENTEST_BOOTLOADERS" != "false" ]
-    then
-        case $m in
-            am335x-evm|beaglebone )
-                if [ -f $test_dir/temp/board-support/prebuilt-images/u-boot-$m.* ]
-                then
-                    uboot="~secondary_bootloader=$(ls $test_dir/temp/board-support/prebuilt-images/u-boot-$m.*)"
-                fi
-
-                if [ -f $test_dir/temp/board-support/prebuilt-images/u-boot-spl.bin-$m ]
-                then
-                    spluart="~primary_bootloader=$(ls $test_dir/temp/board-support/prebuilt-images/u-boot-spl.bin-$m)"
-                fi
-                ;;
-        esac
-    fi
-
-    skern=""
-    fwinit=""
-    case $machine in
-        k2hk-evm|k2e-evm|k2g-evm|k2l-evm )
-            skern="~skern_file=$(ls $test_dir/temp/board-support/prebuilt-images/skern-*.bin)"
-            fwinit="~initramfs=$(ls $test_dir/temp/board-support/prebuilt-images/k2-fw-initrd.cpio.gz)"
-            ;;
-    esac
-
-    pmmc=""
-    case $machine in
-        k2g-evm )
-            pmmc="~pmmc=$(ls $test_dir/temp/board-support/prebuilt-images/ti-sci-firmware-k2g.bin)"
-            ;;
-    esac
-
-    bootattempts=""
-    boottimeout=""
-    if [ -n $OPENTEST_BOOT_ATTEMPTS ]
-    then
-        bootattempts="~var_boot_attempts=$OPENTEST_BOOT_ATTEMPTS"
-    fi
-    if [ -n $OPENTEST_BOOT_TIMEOUT ]
-    then
-        boottimeout="~var_boot_timeout=$OPENTEST_BOOT_TIMEOUT"
-    fi
-
-
-    # Start the STAF process if not already started
-    daemonize $STAF_ROOT/startSTAFProc.sh
-    source $STAF_ROOT/STAFEnv.sh start
-
-    # if OPENTEST_TEE_IP is not set in config, default to Dallas TEE
-    if [ -z $OPENTEST_TEE_IP ]
-    then
-        OPENTEST_TEE_IP="128.247.105.52"
-    fi
-
-    # if OPENTEST_TEE_IP is set to "none", disable assigning to a specific TEE
-    if [ "$OPENTEST_TEE_IP" == "none" ]
-    then
-        ASSIGN_TO_TEE=""
-    else
-        ASSIGN_TO_TEE="~assign_to_tees=\"vatf on $OPENTEST_TEE_IP\""
-    fi
-
-    # if OPENTEST_HW_CAP is not set in config, default to "linux"
-    if [ -z $OPENTEST_HW_CAP ]
-    then
-        OPENTEST_HW_CAP="linux"
-    fi
-
-    # Call opentest framework.  Echo the command being used for logging
-    echo "java -jar $OPENTEST_JAR --template penguin --hw platform=$oplatform,$OPENTEST_HW_CAP --sw kernel=$kernel$dtb~kernel_modules=$spluart$uboot$skern$fwinit$pmmc$bootattempts$boottimeout~nfs=$ipaddr:$nfs_dir$ASSIGN_TO_TEE~test_scripts_root=git://http://arago-project.org/git/projects/test-automation/execution-engines/vatf-scripts.git --options \"priority 0\" --params script=/$TEST_SCRIPTS_TGT/opentest.sh"
-    if [ "${BUILD_LOG_VERBOSE}" = "true" ]; then
-        java -jar $OPENTEST_JAR --template penguin --hw platform=$oplatform,$OPENTEST_HW_CAP --sw kernel=$kernel$dtb~kernel_modules=$spluart$uboot$skern$fwinit$pmmc$bootattempts$boottimeout~nfs=$ipaddr:$nfs_dir$ASSIGN_TO_TEE~test_scripts_root=git://http://arago-project.org/git/projects/test-automation/execution-engines/vatf-scripts.git --options "priority 0" --params script=/$TEST_SCRIPTS_TGT/opentest.sh 2>&1 | eval tee -a $machine_test_log
-        otret=${PIPESTATUS[0]}
-    else
-        java -jar $OPENTEST_JAR --template penguin --hw platform=$oplatform,$OPENTEST_HW_CAP --sw kernel=$kernel$dtb~kernel_modules=$spluart$uboot$skern$fwinit$pmmc$bootattempts$boottimeout~nfs=$ipaddr:$nfs_dir$ASSIGN_TO_TEE~test_scripts_root=git://http://arago-project.org/git/projects/test-automation/execution-engines/vatf-scripts.git --options "priority 0" --params script=/$TEST_SCRIPTS_TGT/opentest.sh
-        otret=$?
-    fi
-
-    if [ "${BUILD_LOG_VERBOSE}" = "true" ]; then
-        oturl=`eval grep 'LOG\ PATH' $machine_test_log | egrep -o 'href="([^"]*)' | cut -d\" -f2 | sed 's/dev_test_\([[:digit:]]\+\).html/dut1_\1_log.txt/'`
-        eval wget --no-proxy "$oturl" -O $machine_console_log
-    fi
-
-################################################################################
-# Check the results of the opentest run.
-#   - If the test failed mark the failure and exit
-#   - If the test passed then cleanup the NFS file system and repackage it
-#     into the SDK.  This way we can ship a pre-booted file system.
-################################################################################
-    # This is not marked as a critical failure because this could be a false
-    # failure from the test system itself.  So depending on what we set for
-    # SKIP_TEST_FAILURES we may continue with the packaging step.
-    if [ $otret -ne 0 ]
-    then
-        echo "Opentest failed for $m"
-        echo "FAILED" > $LOG_DIR/$m-test-result.txt
-        return 1
-    fi
-}

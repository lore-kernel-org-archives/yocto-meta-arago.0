-#!/bin/bash
-
-dmips_range="0.2"
-
-case $arch in
-  armv7a )
-    dmips="1.9"
-    ;;
-  armv5te )
-    dmips="0.9"
-    ;;
-esac
-
-val=`runDhrystone | grep DMIPS/MHz | sed 's/.*= *//'`
-max=`echo "$dmips $dmips_range" | awk '{print $1 + $2}'`
-min=`echo "$dmips $dmips_range" | awk '{print $1 - $2}'`
-
-ret=`echo "$val $min $max" | awk '{if (($1 > $2) && ($1 < $3)) print "true"; else print "false"}'`
-
-if [ "$ret" == "false" ]
-then
-  exit 1
-fi
-
-exit 0

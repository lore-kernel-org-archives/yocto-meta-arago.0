>> ++static void
>> ++_lreInterfaceConfigTable_container_row_restore(const char *token, char *buf)
>> ++{
>> ++    lreInterfaceConfigTable_rowreq_ctx * rowreq_ctx;
>> ++    netsnmp_index index;
>> ++    oid tmp_oid[ MAX_lreInterfaceConfigTable_IDX_LEN];
>> ++    u_int col = 0, found = 0;
